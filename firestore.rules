rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'coins', 'currentLevel', 'totalCorrect', 'totalWrong']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() <= 100 &&
        data.coins is number && data.coins >= 0 &&
        data.currentLevel is number && data.currentLevel >= 1 &&
        data.totalCorrect is number && data.totalCorrect >= 0 &&
        data.totalWrong is number && data.totalWrong >= 0 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 64)) &&
        (!('superheroTitle' in data) || (data.superheroTitle is string && data.superheroTitle.size() <= 100)) &&
        (!('superheroPower' in data) || (data.superheroPower is string && data.superheroPower.size() <= 100)) &&
        (!('slogan' in data) || (data.slogan is string && data.slogan.size() <= 200)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 50)) &&
        (!('equippedRoom' in data) || (data.equippedRoom is string && data.equippedRoom.size() <= 100)) &&
        (!('equippedAccessory' in data) || (data.equippedAccessory is string && data.equippedAccessory.size() <= 100)) &&
        (!('totalRounds' in data) || (data.totalRounds is number && data.totalRounds >= 0)) &&
        (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
        (!('claimedBonus' in data) || (data.claimedBonus is bool)) &&
        (!('unlockedCharacters' in data) || (data.unlockedCharacters is list && data.unlockedCharacters.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health connection probe document
    match /test/connection {
      allow read: if true;
    }

    // User progress and profile document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().userId == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }
  }
}
